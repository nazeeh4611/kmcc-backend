# Server
NODE_ENV=development
PORT=3003
CLIENT_URL=http://localhost:3000

# MongoDB Atlas
MONGO_URI=

# JWT — admin and member sessions are signed with fully separate secrets so
# an admin token can never verify against a member endpoint or vice versa.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
MEMBER_JWT_ACCESS_SECRET=
MEMBER_JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Global KMCC Anganganadi Panchayath <no-reply@kmccpanchayath.org>"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Super Admin seed (used only by seed script)
SUPER_ADMIN_NAME=Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
